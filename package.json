{
  "name": "@nemesis-oss/nexum",
  "version": "2.0.0",
  "description": "Nexum \u2014 open-source agent runtime and harness for autonomous software engineering (umbrella package: kernel, models, tools, MCP and the devagent product plane).",
  "keywords": [
    "nexum",
    "agent-runtime",
    "agent",
    "ai",
    "llm",
    "coding-assistant",
    "tui",
    "cli",
    "typescript",
    "docker",
    "sandbox",
    "lsp",
    "mcp",
    "ollama"
  ],
  "license": "MIT",
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "homepage": "https://github.com/nemesis-oss/nexum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nemesis-oss/nexum.git"
  },
  "bugs": {
    "url": "https://github.com/nemesis-oss/nexum/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nexum": "bin/cli.js",
    "devagent": "bin/cli.js",
    "devagent-ts": "bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p packages/core && tsc -p packages/models && tsc -p packages/tools && tsc -p packages/mcp && tsc -p packages/devagent && tsc -p tsconfig.json",
    "test": "NEXUM_TEST_NO_GLOBAL=true node --experimental-vm-modules node_modules/.bin/jest",
    "start": "node packages/devagent/dist/tui/index.js",
    "dev": "tsx --tsconfig tsconfig.dev.json packages/devagent/src/tui/index.ts",
    "dev:legacy": "tsx --tsconfig tsconfig.dev.json packages/devagent/src/cli/tui.ts",
    "benchmark": "tsx --tsconfig tsconfig.dev.json packages/devagent/src/benchmark/cli.ts",
    "docs:ingest": "tsx --tsconfig tsconfig.dev.json packages/devagent/src/cli/docs-ingest.ts",
    "doctor": "tsx --tsconfig tsconfig.dev.json packages/devagent/src/cli/doctor.ts",
    "migrate": "tsx --tsconfig tsconfig.dev.json packages/devagent/src/cli/migrate.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint packages src tests",
    "format:check": "prettier --check packages src tests",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/jest": "^30.0.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "ts-jest": "^29.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@nemesis-oss/nexum-core": "^2.0.0",
    "@nemesis-oss/nexum-models": "^2.0.0",
    "@nemesis-oss/nexum-tools": "^2.0.0",
    "@nemesis-oss/nexum-mcp": "^2.0.0",
    "@nemesis-oss/nexum-devagent": "^2.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  },
  "workspaces": [
    "packages/*"
  ]
}
