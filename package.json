{
  "name": "@nemesis-oss/devagent-ts",
  "version": "1.0.0",
  "description": "Autonomous, developer-focused AI coding assistant runtime and terminal UI powered by local & cloud Ollama models with capability routing, Docker sandbox, and LSP code intelligence.",
  "keywords": [
    "ollama",
    "devagent",
    "devagent-ts",
    "agent",
    "ai",
    "llm",
    "coding-assistant",
    "tui",
    "cli",
    "typescript",
    "docker",
    "sandbox",
    "lsp",
    "mcp"
  ],
  "license": "MIT",
  "author": "Shubham Taywade <shubhamtaywade82@gmail.com>",
  "homepage": "https://github.com/shubhamtaywade82/devagent-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamtaywade82/devagent-ts.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamtaywade82/devagent-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devagent": "bin/cli.js",
    "devagent-ts": "bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "DEVAGENT_TEST_NO_GLOBAL=true node --experimental-vm-modules node_modules/.bin/jest",
    "start": "node dist/tui/index.js",
    "dev": "tsx src/tui/index.ts",
    "dev:legacy": "tsx src/cli/tui.ts",
    "benchmark": "tsx src/benchmark/cli.ts",
    "docs:ingest": "tsx src/docs/cli.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/jest": "^30.0.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "ts-jest": "^29.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nemesis-oss/ollama-sdk": "^1.3.0",
    "better-sqlite3": "^12.11.1",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ora": "^9.4.1",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "vscode-languageserver-protocol": "^3.18.2",
    "vscode-languageserver-types": "^3.18.0",
    "vscode-uri": "^3.1.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider/provider.d.ts",
      "import": "./dist/provider/provider.js"
    },
    "./catalog": {
      "types": "./dist/provider/catalog.d.ts",
      "import": "./dist/provider/catalog.js"
    },
    "./router": {
      "types": "./dist/provider/router.d.ts",
      "import": "./dist/provider/router.js"
    },
    "./agent": {
      "types": "./dist/cli/agent.d.ts",
      "import": "./dist/cli/agent.js"
    }
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
